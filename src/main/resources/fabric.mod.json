	"icon": "assets/schaltplanmod/icon.png",
	"authors": [
		"cirby"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.jesse.schaltplanmod.SchaltplanMod"
		],
		"client": [
			"de.jesse.schaltplanmod.client.SchaltplanModClient"
		]
	},
	"mixins": [
		"schaltplanmod.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
